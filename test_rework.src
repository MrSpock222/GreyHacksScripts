list.get = function(x)
	r = []
	for e in self
		if x[0] == "*" and e.name.matches(x[1:]) then r.push(e)
		if e.name == x then return e
	end for
	if r.len != 0 then return r else return null
end function

string.mark = function(word, color) //Mark words without messing with the format_columns func
    colortag = "<color=" + color + ">"

    if typeof(word) == "list" then
        for obj in word
            newWord = colortag + obj + "</color>"
            self = self.replace(obj,newWord)
        end for
        return self
    else if typeof(word) == "string" then
        newWord = colortag + word + "</color>"
        self = self.replace(word,newWord)
        return self
    end if

    return "<color=red><b>Failed to mark string!</b></color>"

end function

MainFuncs = {}
MainFuncs.Execute = {}
MainFuncs.Execute.passwordIsValid = false
MainFuncs.Execute.isLocalStart = false
MainFuncs.Execute.isClearStart = false
MainFuncs.Execute.run = function(p)
    flags = p[0]
    arguments = p[1:]

    if flags[0] != "-" or flags.trim == "-" then exit("<color=red>Invalid argument")


    Options = {}
    Options.p = function
        if arguments.len > 1 then exit("<color=red>" + __name + " -p only allows 1 argument")
        if arguments.len != 1 then exit("<color=red>" + __name + " -p needs 1 argument")
        if arguments[0] != password then exit("<color=red>Wrong password!")
        MainFuncs.Execute.passwordIsValid = true
    end function
    Options.l = function
        MainFuncs.Execute.isLocalStart = true
    end function
	Options.c = function
        MainFuncs.Execute.isClearStart = true
    end function

    for option in flags[1:]
        if not Options.hasIndex(option) then return exit("<color=red>Invalid flag -" + option)
        Options[option]
    end for

end function

MainFuncs.chosesmth = function(listOfVariables = ["option 1"], descriptionText = "No description set", anyKey = true)

	print("-------------------------------------------")
	print(descriptionText)
	for var in listOfVariables
		print(var)
	end for
	print("-------------------------------------------")
	
	while (true)
		option = user_input("Input: ", false,anyKey).trim.to_int
		if option == "" then return -1
		if option >= 1 and option <= listOfVariables.len then return option - 1
		print("Please enter a valid number")
	end while

	return option - 1
end function

MainFuncs.getLanInject = function(address)

	ips = []
	if is_lan_ip(address) then 
		router = get_router
	else
		router = get_router(address)
	end if

	for ip in MainFuncs.getTotalIpsConnected(router)
		if not ip.matches(router.local_ip) then ips.push(ip)
	end for

	return ips
end function

MainFuncs.GetFinalPath = function(command)
    paths = [current_path, "/bin", "/usr/bin"]
	for i in range(0, paths.len - 1)
	    if i == 0 then
		    absPath = get_abs_path(command)
		else 
		    absPath = paths[i] + "/" + command
		end if
	 	cmdFile = Current.computer.File(absPath)
		if (cmdFile != null) then return absPath
	end for
	return command
end function

MainFuncs.connectToWlan = function
	comp = obj.Shells[0].host_computer

	//GET NET DEVICE
	netDevices = comp.network_devices.split(char(10))
	netDevice = null
	for device in netDevices
		if not device then continue
		device = device.split(" ")
		res = Current.crypt.airmon("start", device[0])
		if typeof(res) != "string" then 
			Current.crypt.airmon("stop", device[0])
			netDevice = device[0]
			break
		end if
	end for

	if not netDevice then return print("<color=red>No wifi interface found")
	//GET NET DEVICE END


	networks = comp.wifi_networks(netDevice)
	res = Current.crypt.airmon("start", netDevice)
	if res == -1 then return
	if typeof(res) == "string" then return print("There was an error while switching monitoring mode: " + res)

	vals = []
	for network in networks
		vals.push(network.split(" ")[1][:-1])
	end for

	vals.sort.reverse

	for v in range(0,vals.len-1)
		for n in networks
			if n.matches(vals[v]) then 
				vals[v] = n.split(" ")[0] + " " + vals[v] + "% " + n.split(" ")[2]
				break
			end if
		end for
	end for

	text = "Choose a wifi to connect:"
	option = MainFuncs.chosesmth(vals,text,false)
	if option == -1 then return

	clear_screen
	network = vals[option].split(" ")
	bssid = network[0]
	essid = network[2]
	pwr = network[1][:-1].to_int
	potentialAcks = 300000/(pwr+15)
	bssid = network[0]
	print("Finishing after " + round(potentialAcks) + "acks...")
	startTime = time
	Current.crypt.aireplay(bssid,essid,potentialAcks)

	wpw = Current.crypt.aircrack(home_dir + "/file.cap")
	print("Finished after " + round(time - startTime,2) + "s")
	print("<color=orange>Wifi password for " + essid + " is " + wpw)

	comp.connect_wifi(netDevice,bssid,essid,wpw)
	Current.crypt.airmon("stop", netDevice)
	comp.File(home_dir + "/file.cap").delete

end function

MainFuncs.setHackshopIP = function
	aptclient = include_lib("/lib/aptclient.so")
	if not aptclient then aptclient = include_lib(current_path + "/aptclient.so")
	if not aptclient then exit("There is no aptclient.so at " + current_path + " or /lib")

	if not aptclient.search("metaxploit.so").is_match("not found") then return print("HackshopIP Found")
	ip = ""
	print("Searching for hackshopIP....")
	while(aptclient.search("metaxploit.so").is_match("not found"))
		if ip != "" then aptclient.del_repo(ip)
		ip = MainFuncs.rndIp
		aptclient.add_repo(ip)
		aptclient.update
	end while
	print("HackshopIP Found\n" + ip)
end function

MainFuncs.isNewShell = function(shell)
	for s in range(obj.Shells.len - 1,0)
		if obj.Shells[s].host_computer.local_ip == shell.host_computer.local_ip and obj.Shells[s].host_computer.public_ip == shell.host_computer.public_ip then 
			return true
		end if
	end for
	return false
end function

MainFuncs.getTotalIpsConnected = function(router)
	islocal = get_router.public_ip == router.public_ip
	total = router.devices_lan_ip.sort

	if islocal then
		hold = []
		for ip in total
			if typeof(get_router(ip)) == "router" then hold.push(ip)
		end for

		for ip in hold
			r = get_router(ip).devices_lan_ip
			for i in r
				if total.indexOf(i) == null then total.push(i)
			end for
		end for
	end if

	return total
end function

MainFuncs.GetMemEntry = function(metaLib)
	libInfo = metaLib.lib_name + " " + metaLib.version

	codesFile = MainFuncs.getFiles(obj.Shells[0], "", ".Trash").get(codesFileName)
	if not codesFile then return null

	lines = codesFile.get_content.split(char(10))
	index = lines.indexOf(libInfo)

	if index == null then return null

	XPLOITS = []
	index = index + 1

	while lines[index].matches("Type")
		vals = lines[index].split(" ")
		XPLOITS.push([vals[5],vals[6],vals[1],vals[2]])
		index = index + 1
		if index >= lines.len then break
	end while

	return XPLOITS

end function

MainFuncs.ScanMetalib = function(metaLib)
	memory = get_custom_object["mx0"].scan(metaLib)
	if not memory then return "Update your metaxploit.so libary!"

	XPLOITS = []
	for mem in memory
		address = Current.metaxploit.scan_address(metaLib, mem).split("Unsafe check: ")
		for add in address
			if add == address[0] then continue
			value = add[add.indexOf("<b>") + 3 : add.indexOf("</b>")]
			value = value.replace("\n", "")
			XPLOITS.push([mem,value])
		end for
	end for

	return XPLOITS
end function

MainFuncs.WriteMemEntry = function(libInfo, toWriteMem)
	codesFile = MainFuncs.getFiles(obj.Shells[0], "", ".Trash").get(codesFileName)
	if codesFile == null then codesFile = MainFuncs.createFile(obj.Shells[0],codesFileName,"/home/" + Current.user)

	toWriteMem.insert(0,libInfo)
	toWriteMem = toWriteMem.join(char(10))
	if codesFile.get_content.trim == "" then cont = toWriteMem else cont = char(10) + toWriteMem
	codesFile.set_content(codesFile.get_content + cont)

	toWriteMem = toWriteMem.split(char(10))
	toWriteMem.remove(0)
end function



MainFuncs.buildPortMap = function(address)
	Target.info = []
	Target.ports = []


	portInfo = ["INDEX PORT STATUS SERVICE INFO LAN"]
	portIndex = 1
	allLanDevices = []
	ports = null

	
	isLanIp = is_lan_ip(address)

	if isLanIp then
		router = get_router
	else
		router = get_router( address )
	end if

	if router == null then return print("Ip address not found")

	if not isLanIp then
		ports = router.used_ports
	else
		ports = router.device_ports(address)
	end if

	if ports == null then return print("Ip address not found")

	if typeof(ports) == "string" then return print(ports)

	Target.ip = address

	//PUSH ROUTER TO ADDRESS LIST
	service_info = router.kernel_version
	portInfo.push(portIndex + " " + router.public_ip + " " + "gateway" + " " + "router" + " " + service_info + " " + router.local_ip)
	portIndex = portIndex + 1
	Target.ports.push(0)
	//PUSH ROUTER TO ADDRESS LIST
	
	for port in ports
		service_info = router.port_info(port)
		lan_ips = port.get_lan_ip
		port_status = "open"

		if(port.is_closed and not isLanIp) then
			port_status = "closed"
		end if

		if lan_ips == router.local_ip then continue
		portInfo.push(portIndex + " " + port.port_number + " " + port_status + " " + service_info + " " + lan_ips)
		portIndex = portIndex + 1
		Target.ports.push(port.port_number)
	end for

	total = MainFuncs.getTotalIpsConnected(router).sort

	stats = ["internal", "router", "switch"]
	num = 0

	for el in total.sort
		c = router.device_ports(el)
		if typeof(c) == "string" then 
			allLanDevices.push("FIREWALL Detected @ addr: " + port.get_lan_ip)
		else
			for port in c

				if port.port_number == 8080 then
					num = 1
					if get_switch(port.get_lan_ip) != null and get_switch(port.get_lan_ip).local_ip == port.get_lan_ip then num = 2
				else 
					num = 0
				end if

				info = port.port_number + " " + stats[num] + " " + router.port_info(port) + " " + port.get_lan_ip
				if allLanDevices.indexOf(info) != null then continue
				allLanDevices.push(info)
			end for
		end if
	end for

	//FIREWALL RULES
	if not firewall_rules(router) then 
		routerInfo = "No firewall rules detected."
	else
		out = "ACTION PORT SOURCE-IP DESTINATION-IP\n"
		for rule in firewall_rules(router)
			out = out + rule + "\n"
		end for
		routerInfo = format_columns(out)
	end if


	//MAINMAP
	seperator = "-------------------------------------------"

	headInfo = "Scanning IP: " + address + char(10) +
				"Found: " + total.len + " machines connected!" + char(10) +
				router.bssid_name + " : " + router.essid_name + char(10) +
				total.join(char(10)) + char(10) +
				seperator + char(10)

	
	portInfo = format_columns(portInfo.join(char(10))) + char(10) +
				seperator + char(10)

	lanDeviceInfo = format_columns(allLanDevices.join("\n")) + char(10) +
					seperator + char(10)

	routerInfo = "ROUTER" + char(10) +
				routerInfo + char(10) +
				seperator + char(10)


	//COLOR KOWN LIBS
	portInfo = portInfo.split(char(10))
	index = 0
	for port in Target.ports
		index = index + 1

		net_session = Current.metaxploit.net_use(Target.ip, port)
		if not net_session then continue
		metaLib = net_session.dump_lib
		if MainFuncs.GetMemEntry(metaLib) then 
			portInfo[index] = portInfo[index].mark(metaLib.version,"green")
		end if

	end for
	portInfo = portInfo.join(char(10))
	//COLOR KOWN LIBS END

	//COLOR MODIFY
	lanDeviceInfo = lanDeviceInfo.mark("internal","green")
	lanDeviceInfo = lanDeviceInfo.mark("router","yellow")
	lanDeviceInfo = lanDeviceInfo.mark("switch","red")
	//COLOR MODIFY END
	
	Target.info = headInfo + portInfo + lanDeviceInfo + routerInfo
end function

MainFuncs.rndIp = function()
    ip0 = floor((rnd * 220) + 2)
    ip1 = floor((rnd * 255))
    if ip0 == 10 then ip0 = 222
    if ip0 == 127 then ip0 = 223
    if (ip0 == 192 and ip1 == 168) or (ip0 == 172 and ip1 == 16) then ip1 = 255
    return ip0 + "." + ip1 + "." + floor((rnd * 256)) + "." + floor((rnd * 256)) //Generate a random ip, doesnt start with 1
end function

MainFuncs.Target = function(option,useDatabase)
	if Target.ports.len == 0 then return print("No ip linked yet" + char(10) + "Use <color=orange>scan</color> to link a IP")
	
	if option >= 1 and option <= Target.ports.len then option = Target.ports[option-1]

	net_session = Current.metaxploit.net_use(Target.ip, option) //Net_use prints feedback on fail anyway
	if not net_session then return
	metaLib = net_session.dump_lib

	if option == 0 then 
		lanInject = MainFuncs.getLanInject(Target.ip)
		isrouter = true 
	else 
		lanInject = null
		isrouter = false
	end if

	res = MainFuncs.memCodeSelection(metaLib, isrouter, lanInject, useDatabase)
	if res isa string then print(res)
end function

MainFuncs.dec = {}
MainFuncs.dec.decipher = function(x)
	MainFuncs.PrintPassword(x)
end function
MainFuncs.PrintPassword = function(line)

	userPass = line.split(":")
	if userPass.len != 2 then return ("decipher: wrong syntax")
	password = get_custom_object["mxc"].decipher(userPass[1])
	if not password then print("Can't find password :(")
	if password then
		get_custom_object["succeeded"] = true
		print("\nUser: " + userPass[0])
		print("Password: " + "<color=red>" + password)
	end if

end function

MainFuncs.ShowCredentials = function(files)
	MainFuncs.showAllPasswords(files)
	MainFuncs.showAllMails(files)
end function

MainFuncs.showAllMails = function(files, startFromMainFolder = true)

	holder = ["Mails"]

	GetEntry = function(file)
		if file then file = file.get_content else return holder.push("<space=5em>No mails found.")
		if file == null then return holder.push("<space=5em>No mails found.")

		for entry in file.split(char(10))
			if entry == "" then continue
			holder.push("<space=5em>" + entry)
		end for
	end function


	for file in files
		if typeof(file) == "computer" then 
			holder.push(file.local_ip + ":")
			file = file.File("/")
		end if

		if startFromMainFolder then
			while file.path != "/"
				file = file.parent
			end while
		end if
	
		if not file then return print(file.name + " not found.")
	
		allf = MainFuncs.getFiles(file)
		mailtxt = allf.get("*Mail.txt")

		if mailtxt isa list then 
			for a in mailtxt
				GetEntry(a)
			end for
		else
			GetEntry(mailtxt)
		end if

	end for
	

	if holder.len == 0 then return print("No emails found.")
	print(holder.join(char(10)))

end function

MainFuncs.showAllPasswords = function(files, startFromMainFolder = true)

	holder = ["Passwords"]

	GetEntry = function(file)
		if file then file = file.get_content else return holder.push("<space=5em>No passwords found.")
		if file == null then return holder.push("<space=5em>No passwords found.")

		for entry in file.split(char(10))
			if entry == "" then continue
			if holder.indexOf(entry) == null then holder.push("<space=5em>" + entry)
		end for
	end function


	for file in files
		if typeof(file) == "computer" then 
			holder.push(file.local_ip + ":")
			file = file.File("/")
		end if

		if startFromMainFolder then
			while file.path != "/"
				file = file.parent
			end while
		end if
	
		if not file then return print(file.name + " not found.")
	
		allf = MainFuncs.getFiles(file)
		passwd = allf.get("*passwd")
		if passwd isa list then 
			for a in passwd
				GetEntry(a)
			end for
		else
			GetEntry(passwd)
		end if
	end for
	

	if holder.len == 0 then return print("No passwords found.")
	print(holder.join(char(10)))
end function

MainFuncs.copytotarget = function(targetShell)
	
	loc = MainFuncs.getFiles(targetShell,"wrx", ".Trash").get(MainFuncs.checkuser(targetShell)).path
	kit = MainFuncs.getFiles(obj.Shells[0]).get("kit")
	
	kit.chmod("o+wrx")
	for file in kit.get_files
		file.chmod("o+wrx")
	end for

	if not kit then return print("Test kit is missing")

	print("Installing test-kit on target...")

	res = obj.Shells[0].scp(kit.path,loc, targetShell)
	if res == "string" then print("Error: " + res)

	kit.chmod("o-wrx")
	for file in kit.get_files
		file.chmod("o-wrx")
	end for

	return loc + "/kit/" + program_path.split("/")[-1]
end function

MainFuncs.kit = {}
MainFuncs.kit.launch = function(targetShell)
	
	if not MainFuncs.getFiles(obj.Shells[0], "wrx", ".Trash").get("kit") then 
		userChoice = ""
		while (true)
			userChoice = user_input("Test-kit does not exist.\nDo you want to create it and proceed? y/n ", false, true).trim
			if userChoice == "" then continue
			if userChoice.lower == "n" or userChoice.lower == "y" then break
		end while
		if userChoice.lower == "y" then 
			MainFuncs.kit.CreateKit()
		else
			return print("Launch kit interrupted")
		end if
	end if

	print("Updating metaxploit.so...")

	metaxlib = obj.Shells[0].host_computer.File("/lib/metaxploit.so")
	if not metaxlib then metaxlib = MainFuncs.getFiles(obj.Shells[0]).get("metaxploit.so")
	if not metaxlib then return print("Metaxploit libary could not be found!")

	res = obj.Shells[0].host_computer.File(metaxlib.path).copy(MainFuncs.getFiles(obj.Shells[0]).get("kit").path, "metaxploit.so")
	if res == "string" then return("Failed updating metaxploit.so at kit!")

	loc = MainFuncs.copytotarget(targetShell)

	targetShell.launch(MainFuncs.getFiles(targetShell,"x",".Trash").get("cd").path)
	launch(targetShell, loc, "-pl " + password)
end function

MainFuncs.kit.install = function(codesFileName)
	MainFuncs.kit.CreateKit()
end function

MainFuncs.kit.CreateKit = function
	shell = obj.Shells[0]
	currComp = shell.host_computer
	testfile = currComp.File(program_path)
	startTime = time

	if currComp.File(current_path + "/kit") then 
		print("<color=red>Test-kit already exists")
		return UpdateKit
	end if

	files = MainFuncs.getFiles(shell, "",".Trash")
	metaxfile = files.get("metaxploit.so")
	cryptfile = files.get("crypto.so")
	codesFile = files.get(codesFileName)

	if not metaxfile then return print("Metaxploit lib is missing")
	if not cryptfile then return print("Crypto lib is missing")
	folderpath = current_path + "/kit"

	print("Creating test kit...")
	res = currComp.create_folder(current_path, "kit")
	if res == "string" then return print("Creation of kit folder failed: " + res)
	print("Creating metaxploit.so...")
	res = metaxfile.copy(folderpath,"metaxploit.so")
	if res == "string" then return print("Creation of metaxploit.so at " + folderpath + " failed.")
	print("Creating crypto.so...")
	res = cryptfile.copy(folderpath,"crypto.so")
	if res == "string" then return print("Creation of crypto.so at " + folderpath + " failed.")
	if codesFile then 
		print("Moving " + codesFileName + "...")
		res = codesFile.move(folderpath,codesFileName)
	end if
	if res == "string" then return print("Creation of " + codesFileName + " at " + folderpath + " failed.")
	print("Creating TEST...")
	res = testfile.copy(folderpath,program_path.split("/")[-1])
	if res == "string" then return print("Creation of TEST at " + folderpath + " failed.")


	print("Finished in " + round(time-startTime,2) + "s")
	print("Test kit got created.")
end function

MainFuncs.kit.UpdateKit = function
	shell = obj.Shells[0]
	testfile = shell.host_computer.File(program_path)
	startTime = time

	files = MainFuncs.getFiles(shell, "",".Trash")
	metaxfile = files.get("metaxploit.so")
	cryptfile = files.get("crypto.so")
	codesFile = files.get(codesFileName)

	if not metaxfile then return print("Metaxploit lib is missing")
	if not cryptfile then return print("Crypto lib is missing")
	folderpath = current_path + "/kit"

	print("<color=orange>--> Updating test kit...")
	print("Updating metaxploit.so...")
	res = metaxfile.copy(folderpath,"metaxploit.so")
	if res == "string" then return print("Update of metaxploit.so at " + folderpath + " failed.")
	print("Updating crypto.so...")
	res = cryptfile.copy(folderpath,"crypto.so")
	if res == "string" then return print("Update of crypto.so at " + folderpath + " failed.")
	print("Updating TEST...")
	res = testfile.copy(folderpath,program_path.split("/")[-1])
	if res == "string" then return print("Update of TEST at " + folderpath + " failed.")
	print("Finished in " + round(time-startTime,2) + "s")
	print("Test kit update finished")
end function

MainFuncs.createFile = function(targetMachine,fileName, filePath)
    hostComputer = targetMachine.host_computer
    createResult = hostComputer.touch(filePath, fileName)
    if typeof(createResult) == "number" then
        print(fileName + " file got created at " + filePath)
    else if typeof(createResult) == "string" then 
        print(createResult)
        return null
    end if
    return MainFuncs.getFiles(targetMachine, "", ".Trash").get(fileName)
end function

MainFuncs.printMemWithColor = function(orig)
	input = orig[-1]
	index = orig.len + ":"
	usercolor = "<color=#00ADF1>"
	typecolor = "<color=#CE5D01>"
	memcolor = "<color=#FF0000>"
	space = "     "
	valcolor = memcolor

	input = input.split(" ")
	input[1] = usercolor + input[1] + "</color>"
	input[2] = typecolor + input[2] + "</color>"
	input[5] = memcolor + input[5] + "</color>"
	input[6] = valcolor + input[6] + "</color>"

	output = space + "TYPE: " + input[2] + char(10) +
			space + "USER: " + input[1] + char(10) +
			space + "MEMCODE: " + input[5] + char(10) +
			space + "VALUE: " + input[6]

	format_columns(output)
	output = output[index.len:]
	output = output.insert(0,index)

	return output
	
end function

MainFuncs.overrideMemCode = function(toWriteMem, libInfo)
	toWriteMem = toWriteMem.split(" ")
	type = toWriteMem[2]
	mem = toWriteMem[5]
	value = toWriteMem[6]
	meminfo = mem + " " + value

	codesFile = MainFuncs.getFiles(obj.Shells[0], "", ".Trash").get(codesFileName)

	if codesFile == null then return
	lines = codesFile.get_content.split(char(10))
	index = lines.indexOf(libInfo)

	index = index + 1
	while lines[index].matches("Type")
		if lines[index].split(" ")[5] + " " + lines[index].split(" ")[6] == meminfo then break //matches does not work bc '+' from value is used as regex
		if index >= lines.len then break
		index = index + 1
	end while

	if not lines[index].matches("null") then return
	if toWriteMem[1] != "root" and toWriteMem[1] != "guest" and  toWriteMem[1] != "???" then toWriteMem[1] = "user" //save as user and not username
	if index != -1 then lines[index] = toWriteMem.join(" ") else return //idk why, safety?

	codesFile.set_content(lines.join(char(10)))
end function

MainFuncs.checkuser = function(result)
	user = ""
	rfile = null
	file = null
	if typeof(result) != "shell" and typeof(result) != "file" and typeof(result) != "computer" then return "???"
	if typeof(result) == "computer" then
		file = result.File("/home")
		rfile = result.File("/root")
	else if typeof(result) == "shell" or typeof(result) == "ftpshell" then
		file = result.host_computer.File("/home")
		rfile = result.host_computer.File("/")
	end if
	if rfile and rfile.has_permission("w") then
		user = "root"
	else if rfile and file then
		for folder in file.get_folders
			if folder.has_permission("w") and folder.name != "guest" then user = folder.name
		end for
	end if


	if typeof(result) == "file" then
	file = result
	if file.name != "/" then
		file = file.parent
		while file.name != "/"
			file = file.parent
		end while
	end if

	if not file then return "???"
	if file.has_permission("w") then user = "root"
		for folder in file.get_folders
			if folder.name == "root" then
				if folder.has_permission("w") then user = "root"
			end if
			if folder.name == "home" and user != "root" then
				for sub in folder.get_folders
					if sub.has_permission("w") and sub.name != "guest" then user = sub.name
				end for
			end if
		end for
	end if
	if user == "" then user = "guest"
	return user
end function

MainFuncs.memCodeSelection = function(metaLib, isrouter,lanInject, useDatabase = false)
	memory = MainFuncs.getmemcodes(metaLib, isrouter,lanInject, useDatabase,true)
	if typeof(memory) == "string" then return memory

	text = "<color=blue>----------------------------------------" + char(10) +
	        "INDEX>"

	while (true)
		input = user_input(text, false, false).trim.to_int
		if input <= memory.len and input >= 1 then 
			break
		else if input == "" then
			return
		end if
		print("<color=red>" + input + " is not a valid index")
	end while

	XPLOIT = memory[input-1].split(" ")
	MainFuncs.handle.exploits([XPLOIT[2],XPLOIT[5],XPLOIT[6]], metaLib,isrouter,lanInject)

end function

MainFuncs.getmemcodes = function(metaLib, isrouter, lan_inject, useDatabase = false, printInfo = false)
	toWriteMem = []
	libInfo = metaLib.lib_name + " " + metaLib.version

	Handle = {}
	Handle.Default = function(XPLOIT)
		result = metaLib.overflow(XPLOIT[0], XPLOIT[1])
		userName = MainFuncs.checkuser(result)
		if typeof(result) == "number" then return "Type: " + userName + " password_change at memcode: " + XPLOIT[0] + " " + XPLOIT[1]
		if typeof(result) != "number" then return "Type: " + userName + " " + typeof(result) + " at memcode: " + XPLOIT[0] + " " + XPLOIT[1]
	end function
	Handle.Router = function(XPLOIT)
		result = metaLib.overflow(XPLOIT[0], XPLOIT[1], lan_inject[0])
		userName = MainFuncs.checkuser(result)
		if result == 1 or result == 0 then return "Type: " + userName + " firewall_disable at memcode: " + XPLOIT[0] + " " + XPLOIT[1]
		if typeof(result) == "computer" then return "Type: " + userName + " computer:bounce at memcode: " + XPLOIT[0] + " " + XPLOIT[1]
		if typeof(result) == "shell" or typeof(result) == "null" or typeof(result) == "file" then return "Type: " + userName + " " + typeof(result) + " at memcode: " + XPLOIT[0] + " " + XPLOIT[1]
	end function
	Handle.Database = function(XPLOIT)
		return "Type: " + XPLOIT[2] + " " + XPLOIT[3] + " at memcode: " + XPLOIT[0] + " " + XPLOIT[1]
	end function

	XPLOITS = MainFuncs.GetMemEntry(metaLib)
	if not XPLOITS and useDatabase then return libInfo + " has no entry in database"

	if XPLOITS then
		if printInfo then
			print("<color=blue><b>----------------------------------------------------</b>" + char(10) +
				"DATABASE FOUND: " + "<color=orange><size=120%>" + libInfo + char(10) +
				"<color=blue><b>----------------------------------------------------</b>" + char(10) + char(10) +
				"VULNERABILITIES:")
		end if
	else
		XPLOITS = MainFuncs.ScanMetalib(metaLib)
	end if

	for XPLOIT in XPLOITS
		if useDatabase then
			toWriteMem.push(Handle.Database(XPLOIT))
		else if isrouter then
			toWriteMem.push(Handle.Router(XPLOIT))
		else
			toWriteMem.push(Handle.Default(XPLOIT))
		end if
		if MainFuncs.GetMemEntry(metaLib) then MainFuncs.overrideMemCode(toWriteMem[-1], libInfo)
		if not printInfo then continue
		print(MainFuncs.printMemWithColor(toWriteMem))
		print(char(10))
	end for

	if not MainFuncs.GetMemEntry(metaLib) then MainFuncs.WriteMemEntry(libInfo, toWriteMem)

	if toWriteMem.len == 0 then return null else return toWriteMem
end function

MainFuncs.handle = {}
MainFuncs.handle.exploits = function(XPLOIT, metaLib, isrouter,lan_inject)
	Handle ={}
	Handle.shell = function
		shell = metaLib.overflow(XPLOIT[1], XPLOIT[2])
		if typeof(shell) != "shell" then return
		MainFuncs.handle.shell(shell)
	end function

	Handle.bounce = function
		if isrouter then inp = lan_inject[0] else inp = ""
		comp = metaLib.overflow(XPLOIT[1], XPLOIT[2], inp)
		if typeof(comp) != "computer" then return

		print("Visible ips:")
		for ip in lan_inject
			print(ip)
		end for

		option = MainFuncs.chosesmth(["1: Show credentials", "2: Select a IP"],"Choose a option")
		if option == -1 then return

		if option == 0 then
			comps = []
			for a in range(0,lan_inject.len-1)
				comp = metaLib.overflow(XPLOIT[1], XPLOIT[2], lan_inject[a])
				if typeof(comp) != "computer" then continue
				comps.push(comp)
			end for

			MainFuncs.handle.computer(comps,option)
		end if

		if option == 1 then
			userinput = user_input("Enter a IP>")
			comp = metaLib.overflow(XPLOIT[1], XPLOIT[2], userinput)
			if typeof(comp) != "computer" then return
			MainFuncs.handle.computer([comp])
		end if
		
	end function

	Handle.computer = function
		comp = metaLib.overflow(XPLOIT[1], XPLOIT[2])
		if typeof(comp) != "computer" then return
		MainFuncs.handle.computer([comp])
	end function

	Handle.file = function
		file = metaLib.overflow(XPLOIT[1], XPLOIT[2])
		if typeof(file) != "file" then return
		MainFuncs.handle.file(file)
	end function

	Handle.firewall_disable = function
		res = metaLib.overflow(XPLOIT[1], XPLOIT[2])
	end function

	Handle.password_change = function
		userinput = user_input("Enter a password:", false, false).trim
		res = metaLib.overflow(XPLOIT[1], XPLOIT[2], userinput)
	end function

	Handle.nothing = function
		toWriteMem = []

		if isrouter then 
			result = metaLib.overflow(XPLOIT[1], XPLOIT[2], lan_inject[0])

			if result == 1 or result == 0 then toWriteMem.push("Type: " + MainFuncs.checkuser(result) + " firewall_disable at memcode: " + XPLOIT[1] + " " + XPLOIT[2])
			if typeof(result) == "computer" then toWriteMem.push("Type: " + MainFuncs.checkuser(result) + " computer:bounce at memcode: " + XPLOIT[1] + " " + XPLOIT[2])
			if typeof(result) == "shell" or typeof(result) == "null" or typeof(result) == "file" then toWriteMem.push("Type: " + MainFuncs.checkuser(result) + " " + typeof(result) + " at memcode: " + XPLOIT[1] + " " + XPLOIT[2])
		else
			result = metaLib.overflow(XPLOIT[1], XPLOIT[2])
					
			if typeof(result) == "number" then toWriteMem.push("Type: " + MainFuncs.checkuser(result) + " password_change at memcode: " + XPLOIT[1] + " " + XPLOIT[2])
			if typeof(result) != "number" then toWriteMem.push("Type: " + MainFuncs.checkuser(result) + " " + typeof(result) + " at memcode: " + XPLOIT[1] + " " + XPLOIT[2])
		end if

		MainFuncs.overrideMemCode(toWriteMem, metaLib.lib_name + " " + metaLib.version)
	end function

	if XPLOIT[0] == "null" then 
		return Handle["nothing"]
	else if XPLOIT[0] == "computer:bounce" then 
		Handle["bounce"]
	else 
		Handle[XPLOIT[0]]
	end if
	
end function
MainFuncs.handle.shell = function(shell)

	if MainFuncs.isNewShell(shell) then obj.Shells.push(shell)
	terminal = MainFuncs.getFiles(shell,"x",".Trash").get("Terminal.exe")
	options = ["1: Enter remotely", "2: Launch kit"]
	if terminal then options.push("3: Start Terminal")

	option = MainFuncs.chosesmth(options,"Choose a option")
	if option == -1 then return

	if option == 2 then 
		shell.launch(terminal.path)
	else if option == 1 then
		MainFuncs.kit.launch(shell)
	else if option == 0 then
		Current.shell = shell
		Current.computer = Current.shell.host_computer
		Current.user = MainFuncs.checkuser(shell)
		Current.shell.launch(MainFuncs.getFiles(Current.shell,"x",".Trash").get("cd").path)
		Current.metaxploit = null 
		Current.crypt = null 
	end if
end function

MainFuncs.handle.computer = function(comps, option = null)
	if option == null then option = MainFuncs.chosesmth(["1: Show credentials"], "Choose a option")
	if option == -1 then return
	if option == 0 then MainFuncs.ShowCredentials(comps)
end function

MainFuncs.handle.file = function(file)
	option = MainFuncs.chosesmth(["1: Show credentials"], "Choose a option")
	if option == -1 then return
	if option == 0 then MainFuncs.ShowCredentials([file])
end function

MainFuncs.handle.nothing = function(res)
	if typeof(res) == "file" then MainFuncs.handle.file(res)
	if typeof(res) == "computer" then MainFuncs.handle.computer(res)
	if typeof(res) == "shell" then MainFuncs.handle.shell(res)
end function

MainFuncs.getFiles = function(target = null, permissionFlag = "", excludeFolder = "")
	Files = []
	
	if typeof(target) == "shell" then origin = target.host_computer.File("/")
	if typeof(target) == "computer" then origin = target.File("/")
	if typeof(target) == "file" then 
		origin = target
		while origin.path != "/"
			origin = origin.parent
		end while
	end if

    checkPermission = function(object)
        for permission in permissionFlag
            hasPermission = object.has_permission(permission)
            if hasPermission == null then continue
            if not hasPermission then return false
        end for
        return true
    end function

	GetFiles = function(origin)
		for folder in origin.get_folders
			if folder.name == excludeFolder then continue
            if checkPermission(folder) then Files.push(folder)

			for file in folder.get_files
                if checkPermission(file) then Files.push(file)
			end for

			GetFiles(folder)
		end for
	end function

	GetFiles(origin)
	
	return Files

end function

MainFuncs.includeLib = function(libName)
    lib = include_lib("/lib/" + libName)
    if not lib then lib = include_lib(parent_path(program_path) + "/" + libName)
    if not lib then 
		lib = MainFuncs.getFiles(obj.Shells[0]).get(libName)
		if lib != null then lib = include_lib(lib.path)
	end if
    if not lib then print("There is no " + libName + " at " + current_path + " or /lib")
    return lib
end function

MainFuncs.getLib = function(libName)
    aptclient = include_lib("/lib/aptclient.so")
    if not aptclient then aptclient = include_lib(parent_path(program_path) + "/aptclient.so")
    if not aptclient then exit("There is no aptclient.so at " + parent_path(program_path) + " or /lib")

    //Updating aptclient
    result = aptclient.update()
    if result == "" then print("Updating aptclient was succsessful!") else return print("Updating aptclient failed: " + result)
    //Updating aptclient

    //Updating/Installing lib 
    print("Installing " + libName + "...")
    aptclient.install(libName, "/lib")
    //Updating/Installing lib 

    lib = include_lib("/lib/" + libName)

    return lib
end function



Menu = {}
Menu.init = function()

    if params then MainFuncs.Execute.run(params)
        
    if password != "" and not MainFuncs.Execute.passwordIsValid then //Password check
        while(true)
            if user_input("<size=80%>" + "<color=red>TEST" + "</size>" + "<pos=0%><voffset=-1.2em>" + "Password: " + "</color><size=0%>",true).trim == password then break
            clear_screen
            print("<color=red><b>Wrong password</b>")
        end while
    end if

	PrintStartScreen = function
		if MainFuncs.Execute.isClearStart then return
		clear_screen()
		print("<align=""center"">Hacking Tool" + char(169) + "</align>" + char(10) + 
                "<align=""center""><size=50px>TEST</size></align>" + char(10) + 
                "<align=""center"">" + "by" + " Notschge</align>" + char(10) +
                "Initializing...")
	end function

	PrintStartScreen

	if MainFuncs.Execute.isLocalStart or program_path.matches("kit") then
		if not MainFuncs.Execute.isClearStart then print("This is a local start... Linking metaxploit.so from current machine.")
		Current.metaxploit = MainFuncs.includeLib("metaxploit.so")
		if not Current.metaxploit then Current.metaxploit = include_lib("/lib/metaxploit.so")//Just bc greybel doesnt support apt client yet

		if not MainFuncs.Execute.isClearStart then print("This is a local start... Linking crypto.so from current machine.")
		Current.crypt = MainFuncs.includeLib("crypto.so")
		if not Current.crypt then Current.crypt = include_lib("/lib/crypto.so")//Just bc greybel doesnt support apt client yet
	else if Current.computer.is_network_active then
			MainFuncs.setHackshopIP // UpdateLibs
			Current.metaxploit = MainFuncs.getLib("metaxploit.so")
			Current.crypt = MainFuncs.getLib("crypto.so")
			if not Current.metaxploit then Current.metaxploit = include_lib("/lib/metaxploit.so")//Just bc greybel doesnt support apt client yet
			if not Current.crypt then Current.crypt = include_lib("/lib/crypto.so")//Just bc greybel doesnt support apt client yet
	end if

	if not get_custom_object.hasIndex("mxc") then get_custom_object.mxc = Current.crypt
	if not get_custom_object.hasIndex("mx0") then get_custom_object.mx0 = Current.metaxploit
	
	mainFuncs = {}
	mainFuncs.scan = {}
	mainFuncs.scan.use = "Usage:" + char(10) +
						"<color=orange>scan</color> [IPADDRESS]" + char(10) +
						"<color=orange>scan</color> scans the last scanned ip address" + char(10) +
						"<color=orange>scan rnd</color> scans a random ip address " + char(10) +
						"<color=orange>scan -r</color> scans the local ip address"
	mainFuncs.scan.description = "Scan for ports at desired IP"
	mainFuncs.scan.run = function(x)
		if not Current.metaxploit then return print("<color=red>There is currently no metaxploit.so bound!")
		if not x and not Target.info then return print(mainFuncs.scan.use)

		if x and is_valid_ip(x[0]) then MainFuncs.buildPortMap(x[0])
		if x and x[0] == "-r" then MainFuncs.buildPortMap(get_router.public_ip)
		if x and x[0] == "rnd" then MainFuncs.buildPortMap(MainFuncs.rndIp)
		print(Target.info)
	end function

	mainFuncs.check = {}
	mainFuncs.check.use = "check"
	mainFuncs.check.description = "Check for a desired access (Shell/Computer/File)"
	mainFuncs.check.run = function(x)
		if not Current.metaxploit then return print("<color=red>There is currently no metaxploit.so bound!")
		if Target.ports.len == 0 then return print("No ip linked yet" + char(10) + "Use <color=orange>scan</color> to link a IP")

		type = ["Shell", "Computer", "File"]
		level = ["Root", "User", "Guest"]

		Choose = function(li, message)
			while true
				print(message)
				for a in range(1,li.len)
					print("<space=5em>" + a + ": " + li[a-1])
				end for

				opt = user_input("INDEX>",false,true).to_int
				if opt == "" then return null
				if not opt isa number then continue
				if opt > li.len or opt < 1 then continue
				return li[opt-1].lower
			end while
		end function

		type = Choose(type,"Choose a type:")
		if type == null then return
		level = Choose(level,"Choose a level:")
		if level == null then return

		toPrint = []
		for port in range(Target.ports.len-1)
			net_session = Current.metaxploit.net_use(Target.ip, Target.ports[port]) //Net_use prints feedback on fail anyway
			if not net_session then continue
			metaLib = net_session.dump_lib

			if port == 0 then 
				lanInject = MainFuncs.getLanInject(Target.ip)
				isrouter = true 
			else 
				lanInject = null
				isrouter = false
			end if

			for mem in MainFuncs.getmemcodes(metaLib, isrouter, lanInject, true, false)
				if mem.matches(type) and mem.matches(level) then toPrint.push(["Found " + mem.split(" ")[1] + " " + mem.split(" ")[2] + " at port " + Target.ports[port], mem, metaLib])
			end for
		end for

		if toPrint.len == 0 then return print("Could not find " + level + " " + type)


		while true
			print("Found " + level + " " + type + " at:")
			for a in range(1,toPrint.len)
				print("<space=5em>" + a + ": " + toPrint[a-1][0])
			end for

			opt = user_input("INDEX>",false,true).to_int
			if opt == "" then return
			if not opt isa number then continue
			if opt > toPrint.len or opt < 1 then continue
			XPLOIT = toPrint[opt-1][1].split(" ")
			MainFuncs.handle.exploits([XPLOIT[2],XPLOIT[5],XPLOIT[6]], toPrint[opt-1][2],isrouter,lanInject)
			return
		end while
	end function

	mainFuncs.target = {}
	mainFuncs.target.use = "Usage: target <color=orange><opt:-s> <index>"
	mainFuncs.target.description = "Targets the indexed port of the linked IP"
	mainFuncs.target.run = function(x)
		if not Current.metaxploit then return print("<color=red>There is currently no metaxploit.so bound!")
		if not x then return print(self.use)
		if x[0] == "-s" then arguments = x[1:] else arguments = x
		index = arguments[0].to_int
		if not index isa number then return print(self.use)
		MainFuncs.Target(index,x[0] == "-s")
	end function

	mainFuncs.q = {}
	mainFuncs.q.use = "Usage: q"
	mainFuncs.q.description = "Exits out of test script"
	mainFuncs.q.run = function(x)
		userinput = user_input("Sure you want to quit? [y/n]\n", false, true).trim.lower
		if userinput == "y" then exit("Shutting down...")
		print("Aborting shutdown...")
	end function

	mainFuncs.lib = {}
	mainFuncs.lib.use = "Usage: lib <opt:-a/index/libary>"
	mainFuncs.lib.description = "Scan for local libaries\nUse <color=orange>-a</color> to scan all libaries\nUse <color=orange><index></color> or <color=orange><libary>.so</color> to scan specific libary"
	mainFuncs.lib.run = function(x)
		if not Current.metaxploit then return print("<color=red>There is currently no metaxploit.so bound!")
		text = ["| LIBRARY | VERSION |"]

		GetAllLibs = function
			libs = []
			for lib in MainFuncs.getFiles(Current.shell).get("*.so")
				metaLib = Current.metaxploit.load(lib.path)
				if not metaLib then continue
				info = "| " + metaLib.lib_name + " | v" + metaLib.version +" |"
				if text.indexOf(info) then continue
				text.push(info)
				libs.push(metaLib)
			end for
			if libs.len == 0 then return null else return libs
		end function

		GetLibMap = function(libs)
			text = format_columns(text.join(char(10)))
			text = text.split(char(10))

			for i in range(libs.len-1)
				if MainFuncs.GetMemEntry(libs[i]) then text[i+1] = text[i+1].mark([libs[i].lib_name,"v"+libs[i].version],"green")
			end for
			text = text.join(char(10))

			text = "===================================" + char(10) +
				"<space=4em>>>> SYSTEM LIBRARIES <<<"+ char(10) +
				"==================================="+ char(10) +
				text + char(10) +
				"==================================="

			return text
		end function

		ScanLib = function(lib, attackLib = true)
			print("Scanning: " + lib.lib_name + " " + lib.version)

			if Current.computer.get_name.matches("router") then 
				lanInject = MainFuncs.getLanInject(get_router.local_ip)
				isrouter = true 
			else 
				lanInject = null
				isrouter = false
			end if

			if attackLib then MainFuncs.memCodeSelection(lib, isrouter,lanInject, false) else MainFuncs.getmemcodes(lib, isrouter,lanInject, false,true)
		end function

		ScanAllLibs = function(libs)
			for lib in libs 
				ScanLib(lib, false) 
			end for
		end function

		libs = GetAllLibs
		if not libs then return print("<color=red>No libaries found :(")
		if not x then return print(GetLibMap(libs))
		if x[0] == "-a" then ScanAllLibs(libs)
		
		if x[0].to_int isa number and libs.hasIndex(x[0].to_int) then //If argument isa index
			return ScanLib(libs[x[0].to_int-1])
		else //check argument as libname
			lib = MainFuncs.getFiles(Current.shell).get(x[0])
			if not lib then lib = MainFuncs.getFiles(Current.shell).get(x[0] + ".so")
			if not lib then return print("<color=red>" + x[0] + " is not a valid libary")
			metaLib = Current.metaxploit.load(lib.path)
			if not metaLib then return print("<color=red>" + x[0] + " is not a valid libary")
			return ScanLib(metaLib)
		end if

		return print(self.use)
	end function

	mainFuncs.exit = {}
	mainFuncs.exit.use = "Usage: exit"
	mainFuncs.exit.description = "Exit out of remote connection"
	mainFuncs.exit.run = function(x)
		if isStartShell(Current.shell) then return print("<color=red>You are currently not connected remotely!")
		Current.shell = get_shell
		Current.computer = Current.shell.host_computer
		Current.user = active_user
		Current.shell.launch(MainFuncs.getFiles(Current.shell,"x",".Trash").get("cd").path)
		Current.metaxploit = get_custom_object.mx0
		Current.crypt = get_custom_object.mxc
	end function

	mainFuncs.clear = {}
	mainFuncs.clear.use = "Usage: clear"
	mainFuncs.clear.description = "Clear terminal"
	mainFuncs.clear.run = function(x)
		clear_screen
	end function

	mainFuncs.wlan = {}
	mainFuncs.wlan.use = "Usage: wlan"
	mainFuncs.wlan.description = "Connects to wlan"
	mainFuncs.wlan.run = function(x)
		if x then return print(mainFuncs.getwlan.use)
		MainFuncs.connectToWlan
	end function

	mainFuncs.clearlog = {}
	mainFuncs.clearlog.use = "Usage: clearlog"
	mainFuncs.clearlog.description = "Corrupts log file"
	mainFuncs.clearlog.run = function(x)

		info = "<size=200%>Log cleared</size>"
		emptyRow = "\n<color=#00BBFF><b>-------------------------------------------------------</b>\n"
		file = Current.computer.File("/etc/fstab")

		if file then
			logfile = file.copy("/etc", "log")
			wait(0.02)
			logfile = Current.computer.File("/etc/log")

			if logfile then
				logfile.set_content("deleted")
				logfile.move("/var", "system.log")
			else
				return print("Permissions are lacking to clear logs :()")
			end if
			
			
		else
			return print("Permissions are lacking to clear logs :()")
		end if
		print(emptyRow + info + emptyRow)
	end function

	mainFuncs.sudo = {}
	mainFuncs.sudo.use = "Usage: sudo [user]"
	mainFuncs.sudo.description = "Sudo switches user"
	mainFuncs.sudo.run = function(x)
		if not isStartShell(Current.shell) then return print("<color=red>Only possible at host shell")
		username = x[0]
		if username == "-s" then username = "root"
		usershell = get_shell(username,user_input("Password: ",true,false))
		if not usershell then return print("<color=red>Failed!")
		Current.shell = usershell
		Current.computer = Current.shell.host_computer
		clear_screen
		launch(usershell, program_path,"-pc " + password)
	end function

	mainFuncs.shell = {}
	mainFuncs.shell.use = "Usage: shell [sel]"
	mainFuncs.shell.description = "Use [sel] + index to connect to desired shell"
	mainFuncs.shell.run = function(x)
		PrintAllShells = function
			for e in range(0, obj.Shells.len - 1)
				print("<color=#00CCFF>--------------------------")
				if e == 0 then print("StartShell")
				if e != 0 then print("Shell: " + e)
				suffix = ""
				if obj.Shells[e].host_computer.local_ip == Current.computer.local_ip and obj.Shells[e].host_computer.public_ip == Current.computer.public_ip then suffix = " <color=#8F7900>[Current]"
				print("User: " + MainFuncs.checkuser(obj.Shells[e]) + suffix)
				print("Public IP: " + obj.Shells[e].host_computer.public_ip)
				print("Local IP: " + obj.Shells[e].host_computer.public_ip)
			end for
			print("<color=#00CCFF>--------------------------")
		end function

		if not x then
			PrintAllShells()
		else if x[0] == "s" then
			if x.len < 2 then return PrintAllShells
			if x[1].to_int < obj.Shells.len and x[1].to_int >= 0 then

				print("<color=#00B7FF>--------------------------------------")
				print("Routing to Shell " + x[1].to_int + "\nUser: " + MainFuncs.checkuser(obj.Shells[x[1].to_int]) + "\nPublic IP: " +  obj.Shells[x[1].to_int].host_computer.public_ip + "\nLocal IP: " + obj.Shells[x[1].to_int].host_computer.local_ip)
				print("<color=#00B7FF>--------------------------------------")

				MainFuncs.handle.shell(obj.Shells[x[1].to_int])
			else 
				print("Shell " + x[1] + " does not exist")
			end if
		end if


	end function

	mainFuncs.lock = {}
	mainFuncs.lock.use = "Usage: lock"
	mainFuncs.lock.description = "Locks all files and executeables except Terminal.exe and the sudo cmd\nUse [-] to unlock all\nUse [all] to lock everything for every user"
	mainFuncs.lock.run = function(x)

		if x then
			if x[0] == "-" then 
				if not Current.computer.File("/").has_permission("w") then return print("<color=red>You have no permission to do that!")
				allFiles = MainFuncs.getFiles(Current.shell)
				for file in allFiles
					file.chmod("u+wrx")
					file.chmod("o+wrx")
					file.chmod("g+wrx")
				end for
				print("<color=yellow>=================================================")
				print("<size=200%><color=blue>System unlocked!")
				print("<color=yellow>=================================================")
				return
			else if x[0] == "all" then


				while true
					userinput = user_input("This command will lock all users\nDo you want to proceed y/n\n", false, true).trim
					if userinput == "y" or userinput == "Y" then break
					return print("Process interrupted.")
				end while

				while true
					userinput = user_input("Enter password: ", true).trim
					if userinput == "" and password != "" then return print("Process interrupted.")
					if userinput != password and userinput != "" then continue
					break
				end while

				if not Current.computer.File("/").has_permission("w") then return print("<color=red>You have no permission to do that!")
				allFiles = MainFuncs.getFiles(Current.shell)
				for file in allFiles
					file.chmod("u-wrx")
					file.chmod("o-wrx")
					file.chmod("g-wrx")
				end for
		
				print("<color=yellow>=================================================")
				print("<size=200%><color=blue>System locked!")
				print("<color=yellow>=================================================")
			end if
		else
			if not Current.computer.File("/").has_permission("w") then return print("<color=red>You have no permission to do that!")
			allFiles = MainFuncs.getFiles(Current.shell)
			filesToDelete = ["passwd","Mail.txt","Bank.txt"]
			for file in allFiles
				if filesToDelete.indexOf(file.name) then 
					n = file.name
					res = file.delete
					if res == "" then print(n + " got deleted.") else print("There was an error while deleting " + n + ": " + res)
					continue
				end if
				if file.name.matches("sudo") or file.name.matches("Terminal.exe") or file.name.matches("Terminal") then continue
				file.chmod("o-wrx")
				file.chmod("g-wrx")
			end for
	
			print("<color=yellow>=================================================")
			print("<size=200%><color=blue>System locked!")
			print("<color=yellow>=================================================")
		end if



	end function

	mainFuncs.ps = {}
	mainFuncs.ps.use = "Usage: ps"
	mainFuncs.ps.description = "Displays running processes"
	mainFuncs.ps.run = function(x)
		allProcs = Current.computer.show_procs
		allProcs = allProcs.replace("ps", "<color=red>r<color=orange>shell</color>")

		print(format_columns(allProcs))
	end function

	mainFuncs.kill = {}
	mainFuncs.kill.use = "Usage: kill <color=orange>PID</color>"
	mainFuncs.kill.description = "Kills running process "
	mainFuncs.kill.run = function(x)
		if not x then return print("<color=red>Invalid PID\nUse: kill <color=orange>PID</color> ")
		PID = x[0].to_int
		if typeof(PID) != "number" then return print("<color=red>The PID must be a number")
		
		output = Current.computer.close_program(PID)
		if output == true then return print("Process " + PID + " closed");
		if output then return print("<color=red>" + output)
		print("<color=red>Process " + "<color=orange>" + PID + "</color> not found")
	end function

	mainFuncs.rshell = {}
	mainFuncs.rshell.use = "Usage: rshell"
	mainFuncs.rshell.description = "Runs rshell interface"
	mainFuncs.rshell.run = function(x)

		if not x then
			shells = Current.metaxploit.rshell_server

			if typeof(shells) == "string" then
				print(shells)
				return
			end if

			if shells.len < 1 then 
				print("There are no shells connected!")
				return
			end if

			option = 0
			while (option < 1 or option > shells.len)
				print(shells.len + " shell(s) connected!\n<b>Select a shell to start a terminal:</b>")
				for i in range(0, shells.len - 1)
					print("\n<b>Shell (" + (i + 1) + ")</b>\nPublic IP: " + shells[i].host_computer.public_ip + "\nLocal IP: " + shells[i].host_computer.local_ip)
				end for
				print("-----------")
				option = user_input("Select shell>").trim.to_int
				if option == "" then return
				if typeof(option) != "number" then continue
			end while

			print("Starting shell #" + option)
			shell = shells[option - 1]
			return MainFuncs.handle.shell(shell)
		end if

		KillRshell = function(shell)
			killedSomething = false
			allProcs = shell.host_computer.show_procs.split(char(10))[1:]
			for item in allProcs
				if item.split(" ")[4] == "ps" or item.split(" ")[4] == "rshell_client" then 
					killedSomething = true
					res = shell.host_computer.close_program(item.split(" ")[1].to_int)
					if res == true then
						print("<color=red>r<color=orange>shell" + "</color>" + "[" + item.split(" ")[1] + "]" + " Killed")
					else
						print("<color=red>" + res)
						continue
					end if
				end if
			end for
			if not killedSomething then print("There are no rshell services running on this system")
		end function

		if x[0] == "kill" then KillRshell(Current.shell)

		if x[0] == "-l" or x[0] == "clear" then
			for shell in Current.metaxploit.rshell_server
				print("<color=blue>--------------------------------------")
				print("<color=blue>[" + shell.host_computer.public_ip + ":" + shell.host_computer.local_ip + "]")
				KillRshell(shell)
			end for
		end if

		if x[0] == "listen" then
			default = 2
			waitSeconds = default
			
			if x.len == 2 then
				waitSeconds = x[1].to_int
				if typeof(waitSeconds) != "number" or (waitSeconds < 0.01 or waitSeconds > 300) then waitSeconds = default
			end if


			startShellCount = Current.metaxploit.rshell_server.len
			print("Refreshing every " + round(waitSeconds,2) + "s")
			print("Listening for connection...")

			while true
				currShells = Current.metaxploit.rshell_server
				if currShells.len != startShellCount then
					MainFuncs.handle.shell(currShells[currShells.len - 1])
					break
				end if
				wait(waitSeconds)
			end while	

		end if

		if x[0] == "-i" or x[0] == "install" then
			librs = MainFuncs.includeLib("librshell.so")
			if not librs then return("librshell.so not found")

			out = librs.install_service
			if not out then
				print(out)
				return
			end if
			print("<b>Type 'Browser.exe " + get_router.local_ip + ":8080' to access the router configuration to make sure the service it's accessible</b>")
		end if

		if x[0] == "start" then
			librs = MainFuncs.includeLib("librshell.so")
			if not librs then return("librshell.so not found")

			if not librs then 
				print("librshell.so is not installed\nUse rshell [-i/install] to install Service")
				return
			end if

			rc = librs.start_service

			if typeof(rc) == "string" then return print("Rshell service is already started") else print("Rshell service successfully started")
			if DEBUG then print(rc)
		end if

		if x[0] == "stop" then
			librs = MainFuncs.includeLib("librshell.so")
			if not librs then return("librshell.so not found")

			if not librs then 
				print("librshell.so is not installed\nUse rshell [-i/install] to install Service")
				return
			end if

			rc = librs.stop_service

			if typeof(rc) == "string" then return print("Rshell service is already stopped") else print("Rshell service successfully stopped")
			if DEBUG then print(rc)
		end if

		if x[0] == "run" then
			if not isStartShell(Current.shell) then return print("<color=red>Only possible at host shell\n<color=orange>Note: If the IP is white highlighted")
			
			input = user_input("Choose a Port:", false, false).trim.to_int
			
			print("<color=blue>=================</color>")
			if typeof(input) != "number" then 
				if input != "" then print("<color=red>Wrong Syntax</color>")
				print("<color=orange>Port defaulted to 1000</color>")
				input = 1000
			else
				print("Port: " + input)
			end if


			res = Current.metaxploit.rshell_client(Shells[0].host_computer.public_ip, input, "ps")
			if res then print("Success") else print("Failed")
			print("<color=blue>=================</color>")
		end if



	end function

	mainFuncs.dec = {}
	mainFuncs.dec.use = "Usage: dec [user@password]"
	mainFuncs.dec.description = "Deciphers password"
	mainFuncs.dec.run = function(x)
		if not x then return print(mainFuncs.dec.use)
		if x[0].len > 33 then return MainFuncs.dec.decipher(x[0])
	end function

	mainFuncs.fx = {}
	mainFuncs.fx.use = "fx"
	mainFuncs.fx.description = "Opens FileExplorer.exe"
	mainFuncs.fx.run = function(x)
		f = MainFuncs.getFiles(Current.shell,"x",".Trash").get("FileExplorer.exe").path
		Current.shell.launch(f)
